rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net - Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Helper Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity Validation Helpers
    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 200)) &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 500)) &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidChatSession(data) {
      return data.id is string && isValidId(data.id) &&
             data.userId is string && data.userId == request.auth.uid &&
             data.title is string && data.title.size() <= 200 &&
             (!('geminiModel' in data) || (data.geminiModel is string && data.geminiModel.size() <= 100)) &&
             (!('chatGptModel' in data) || (data.chatGptModel is string && data.chatGptModel.size() <= 100)) &&
             (!('thinkingLevel' in data) || (data.thinkingLevel is string && data.thinkingLevel.size() <= 50)) &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidChatMessage(data) {
      return data.id is string && isValidId(data.id) &&
             data.userId is string && data.userId == request.auth.uid &&
             data.sessionId is string && isValidId(data.sessionId) &&
             data.prompt is string && data.prompt.size() <= 10000 &&
             (!('geminiResponse' in data) || (data.geminiResponse is string && data.geminiResponse.size() <= 50000)) &&
             (!('chatGptResponse' in data) || (data.chatGptResponse is string && data.chatGptResponse.size() <= 50000)) &&
             (!('geminiModel' in data) || (data.geminiModel is string && data.geminiModel.size() <= 100)) &&
             (!('chatGptModel' in data) || (data.chatGptModel is string && data.chatGptModel.size() <= 100)) &&
             (!('geminiThinking' in data) || data.geminiThinking is bool) &&
             (!('geminiThinkingContent' in data) || (data.geminiThinkingContent is string && data.geminiThinkingContent.size() <= 30000)) &&
             (!('comparisonNotes' in data) || (data.comparisonNotes is string && data.comparisonNotes.size() <= 20000)) &&
             (!('status' in data) || (data.status in ['completed', 'generating', 'error'])) &&
             (!('isEdited' in data) || data.isEdited is bool) &&
             (!('editedSource' in data) || (data.editedSource in ['gemini', 'chatgpt', 'none'])) &&
             (!('editedText' in data) || (data.editedText is string && data.editedText.size() <= 50000)) &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId) && isValidId(userId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       incoming().keys().hasAll(['userId', 'createdAt']) &&
                       incoming().keys().hasOnly(['userId', 'email', 'displayName', 'photoUrl', 'createdAt', 'updatedAt']) &&
                       isValidUserProfile(incoming());

      allow update: if isOwner(userId) && isValidId(userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidUserProfile(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'photoUrl', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidId(userId);

      // Sessions Subcollection
      match /sessions/{sessionId} {
        allow get: if isOwner(userId) && isValidId(sessionId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) && isValidId(sessionId) &&
                         incoming().id == sessionId &&
                         incoming().userId == request.auth.uid &&
                         incoming().createdAt is timestamp &&
                         incoming().createdAt <= request.time &&
                         incoming().keys().hasAll(['id', 'userId', 'title', 'createdAt']) &&
                         incoming().keys().hasOnly(['id', 'userId', 'title', 'geminiModel', 'chatGptModel', 'thinkingLevel', 'createdAt', 'updatedAt']) &&
                         isValidChatSession(incoming());

        allow update: if isOwner(userId) && isValidId(sessionId) &&
                         incoming().id == existing().id &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidChatSession(incoming()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'geminiModel', 'chatGptModel', 'thinkingLevel', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(sessionId);

        // Messages Subcollection
        match /messages/{messageId} {
          allow get: if isOwner(userId) && isValidId(messageId);
          allow list: if isOwner(userId);

          allow create: if isOwner(userId) && isValidId(messageId) &&
                           incoming().id == messageId &&
                           incoming().userId == request.auth.uid &&
                           incoming().sessionId == sessionId &&
                           incoming().createdAt is timestamp &&
                           incoming().createdAt <= request.time &&
                           incoming().keys().hasAll(['id', 'userId', 'sessionId', 'prompt', 'createdAt']) &&
                           incoming().keys().hasOnly(['id', 'userId', 'sessionId', 'prompt', 'geminiResponse', 'chatGptResponse', 'geminiModel', 'chatGptModel', 'geminiThinking', 'geminiThinkingContent', 'comparisonNotes', 'status', 'isEdited', 'editedSource', 'editedText', 'createdAt', 'updatedAt']) &&
                           isValidChatMessage(incoming());

          allow update: if isOwner(userId) && isValidId(messageId) &&
                           incoming().id == existing().id &&
                           incoming().userId == existing().userId &&
                           incoming().sessionId == existing().sessionId &&
                           incoming().createdAt == existing().createdAt &&
                           isValidChatMessage(incoming()) &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['prompt', 'geminiResponse', 'chatGptResponse', 'geminiModel', 'chatGptModel', 'geminiThinking', 'geminiThinkingContent', 'comparisonNotes', 'status', 'isEdited', 'editedSource', 'editedText', 'updatedAt']);

          allow delete: if isOwner(userId) && isValidId(messageId);
        }
      }
    }
  }
}
