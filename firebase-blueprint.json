{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Authenticated user's UID" },
        "email": { "type": "string", "description": "User email address" },
        "displayName": { "type": "string", "description": "Display name" },
        "photoUrl": { "type": "string", "description": "Avatar photo URL" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp of creation" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp of last update" }
      },
      "required": ["userId", "createdAt"]
    },
    "ChatSession": {
      "title": "ChatSession",
      "description": "Chat session holding dual AI conversation history",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Session ID" },
        "userId": { "type": "string", "description": "Owner UID" },
        "title": { "type": "string", "description": "Session title or topic summary" },
        "geminiModel": { "type": "string", "description": "Gemini model identifier" },
        "chatGptModel": { "type": "string", "description": "ChatGPT model identifier" },
        "thinkingLevel": { "type": "string", "description": "High or default thinking level" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Update timestamp" }
      },
      "required": ["id", "userId", "title", "createdAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "A dual-model conversation message pair with comparison, editing, and cross-critique tracking",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique message ID" },
        "userId": { "type": "string", "description": "Owner UID" },
        "sessionId": { "type": "string", "description": "Parent session ID" },
        "prompt": { "type": "string", "description": "Prompt sent to the models" },
        "geminiResponse": { "type": "string", "description": "Response from Gemini" },
        "chatGptResponse": { "type": "string", "description": "Response from ChatGPT" },
        "geminiModel": { "type": "string", "description": "Gemini model name" },
        "chatGptModel": { "type": "string", "description": "ChatGPT model name" },
        "geminiThinking": { "type": "boolean", "description": "Whether High Thinking was active" },
        "geminiThinkingContent": { "type": "string", "description": "Thoughts generated by thinking mode" },
        "comparisonNotes": { "type": "string", "description": "Comparison or critique notes" },
        "status": { "type": "string", "description": "Generation status: completed, generating, error" },
        "isEdited": { "type": "boolean", "description": "Whether a response was edited" },
        "editedSource": { "type": "string", "description": "Which model response was edited: gemini, chatgpt, none" },
        "editedText": { "type": "string", "description": "Modified response text" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Update timestamp" }
      },
      "required": ["id", "userId", "sessionId", "prompt", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile documents"
    },
    "/users/{userId}/sessions/{sessionId}": {
      "schema": "ChatSession",
      "description": "Chat conversations belonging to the user"
    },
    "/users/{userId}/sessions/{sessionId}/messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Dual AI chat messages and comparison turns"
    }
  }
}
